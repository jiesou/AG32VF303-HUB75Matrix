`timescale 1 ps/ 1 ps

module example_board (
	LED_D2,
	LED_D3,
	HUB75_ADDR,
	HUB75_CLK,
	HUB75_DATA,
	HUB75_LAT,
	HUB75_OE,
	MATRIXSPI_CS,
	MATRIXSPI_MOSI,
	MATRIXSPI_SCK,
	PIN_HSE,
	PIN_HSI,
	PIN_OSC);
inout 	LED_D2;
inout 	LED_D3;
output 	[3:0] HUB75_ADDR;
output 	HUB75_CLK;
output 	[5:0] HUB75_DATA;
output 	HUB75_LAT;
output 	HUB75_OE;
input 	MATRIXSPI_CS;
input 	MATRIXSPI_MOSI;
input 	MATRIXSPI_SCK;
input 	PIN_HSE;
input 	PIN_HSI;
input 	PIN_OSC;

